generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  dna           UserDNA?
  
  // Profile Dashboard Relations
  courses       UserCourseEnrollment[]
  tools         UserToolSubscription[]
  agents        UserAgentContract[]
  tickets       UserTicket[]
  
  // Syllabus Builder Relations
  trainerMemberships TrainerMembership[]
  syllabuses         CourseSyllabus[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserDNA {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brandColors  String? // Store as comma-separated hex codes
  brandColor1  String?
  brandColor2  String?
  logoUrl      String?
  websiteUrl   String?
  companyName  String?
  profession   String?
  jobTitle     String?
  address      String?
  phone        String?
  
  toneOfVoice     String?
  extraGuidelines String? // @db.Text removed for SQLite compat
  competitors     String? // JSON string
  niches          String? // JSON string
  
  products     Product[]
  
  rawSocialContext String? // Store raw scraped data
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  dnaId       String
  dna         UserDNA  @relation(fields: [dnaId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  imageUrl    String?
  price       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Profile Dashboard Models ---

// Khóa học đã mua
model UserCourseEnrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseId   String
  courseName String
  progress   Int      @default(0) // 0-100
  status     String   @default("active") // active | completed | paused
  
  purchasedAt DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
}

// Tool đã đăng ký
model UserToolSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  toolId    String
  toolName  String
  toolIcon  String?
  status    String   @default("active") // active | expired | cancelled
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI Agent đang thuê
model UserAgentContract {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  agentId    String
  agentName  String
  agentAvatar String?
  taskType   String
  status     String   @default("running") // running | paused | ended
  
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Ticket / Dự án từ Playground
model UserTicket {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title        String
  description  String?
  demoUrl      String?
  quoteAmount  String?  // Store as string (e.g., "2.5M") for now or Float
  status       String   @default("consulting") // consulting | quoted | in_progress | completed | cancelled
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Marketplace Models ---

// Yêu cầu công việc (Job Ticket)
model JobTicket {
  id              String   @id @default(cuid())
  title           String
  description     String
  analysisData    String?  // JSON string - Chứa workflow do Gemini sinh ra
  budget          String?  // Gợi ý ngân sách
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Quan hệ
  postedById      String?  // Người dùng đăng
  takenById       String?  // Trainer nhận việc
}

// Bảng Profile riêng cho AI Trainer / Freelancer
model TrainerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  specialties     String  @default("[]") // JSON string array for SQLite compat
  rating          Float    @default(0)
  jobsCompleted   Int      @default(0)
  rankingTier     String   @default("Novice") // Novice, Pro, Elite
}

// Lịch sử Đấu thầu / Xin nhận việc (Tùy chọn cho nâng cao)
model JobProposal {
  id              String   @id @default(cuid())
  jobId           String
  trainerId       String
  proposedPrice   String?
  proposedTime    String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime @default(now())
}

// ============================================
// --- Syllabus Builder Models (Vibe-Learning) ---
// ============================================

// Tổ chức đối tác chiến lược của Vibework
model Organization {
  id             String   @id @default(cuid())
  name           String   // e.g. "ELIVE Academy"
  slug           String   @unique // e.g. "elive"
  logoText       String   @default("ORG") // Text fallback for logo
  primaryColor   String   @default("#6d28d9")
  secondaryColor String   @default("#2563eb")
  accentColor    String   @default("#7c3aed")
  website        String?
  address        String?
  phone          String?
  email          String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())

  members        TrainerMembership[]
  syllabuses     CourseSyllabus[]
}

// Liên kết giảng viên ↔ Tổ chức đối tác
model TrainerMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("trainer") // trainer | org_admin
  isApproved     Boolean  @default(true)
  joinedAt       DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// Đề cương khóa học theo tiêu chuẩn Vibework Academy
model CourseSyllabus {
  id             String   @id @default(cuid())
  title          String
  courseCode     String?
  status         String   @default("DRAFT") // DRAFT | CERTIFIED

  // 7 Sections bắt buộc — stored as JSON strings
  section1       String?  // Thông tin chung
  section2       String?  // Giới thiệu chương trình
  section3       String?  // Lợi ích khi tham gia
  section4       String?  // Đối tượng học viên
  section5       String?  // Khung chương trình chi tiết
  section6       String?  // Đội ngũ chuyên gia
  section7       String?  // Phương pháp & Đánh giá

  authorId       String
  organizationId String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author         User         @relation(fields: [authorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}
