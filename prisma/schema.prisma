generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  dna           UserDNA?
  
  // Profile Dashboard Relations
  courses       UserCourseEnrollment[]
  tools         UserToolSubscription[]
  agents        UserAgentContract[]
  tickets       UserTicket[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserDNA {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brandColors  String? // Store as comma-separated hex codes
  brandColor1  String?
  brandColor2  String?
  logoUrl      String?
  websiteUrl   String?
  companyName  String?
  profession   String?
  jobTitle     String?
  address      String?
  phone        String?
  
  toneOfVoice     String?
  extraGuidelines String? @db.Text
  competitors     String? // JSON string
  niches          String? // JSON string
  
  products     Product[]
  
  rawSocialContext String? // Store raw scraped data
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  dnaId       String
  dna         UserDNA  @relation(fields: [dnaId], references: [id], onDelete: Cascade)
  
  title       String
  description String?  @db.Text
  imageUrl    String?
  price       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Profile Dashboard Models ---

// Khóa học đã mua
model UserCourseEnrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseId   String
  courseName String
  progress   Int      @default(0) // 0-100
  status     String   @default("active") // active | completed | paused
  
  purchasedAt DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
}

// Tool đã đăng ký
model UserToolSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  toolId    String
  toolName  String
  toolIcon  String?
  status    String   @default("active") // active | expired | cancelled
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI Agent đang thuê
model UserAgentContract {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  agentId    String
  agentName  String
  agentAvatar String?
  taskType   String
  status     String   @default("running") // running | paused | ended
  
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Ticket / Dự án từ Playground
model UserTicket {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title        String
  description  String?  @db.Text
  demoUrl      String?
  quoteAmount  String?  // Store as string (e.g., "2.5M") for now or Float
  status       String   @default("consulting") // consulting | quoted | in_progress | completed | cancelled
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Marketplace Models ---

// Yêu cầu công việc (Job Ticket)
model JobTicket {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  analysisData    Json?    // Chứa workflow do Gemini sinh ra
  budget          String?  // Gợi ý ngân sách
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Quan hệ
  postedById      String?  // Người dùng đăng
  takenById       String?  // Trainer nhận việc
}

// Bảng Profile riêng cho AI Trainer / Freelancer
model TrainerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  specialties     String[] // ["Marketing", "Code react", "Midjourney AI"]
  rating          Float    @default(0)
  jobsCompleted   Int      @default(0)
  rankingTier     String   @default("Novice") // Novice, Pro, Elite
}

// Lịch sử Đấu thầu / Xin nhận việc (Tùy chọn cho nâng cao)
model JobProposal {
  id              String   @id @default(cuid())
  jobId           String
  trainerId       String
  proposedPrice   String?
  proposedTime    String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime @default(now())
}

